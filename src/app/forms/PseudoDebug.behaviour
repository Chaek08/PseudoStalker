<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<behaviours>
  <target id="main_frame">
    <behaviour color="#1a1a1a" offsetX="0" offsetY="0" radius="15" spread="0" type="behaviour\custom\DropShadowEffectBehaviour" when="ALWAYS"/>
  </target>
  <target id="btn_close">
    <behaviour color="#333333" enabled="" offsetX="0" offsetY="0" radius="10" spread="0" type="behaviour\custom\DropShadowEffectBehaviour" when="ALWAYS"/>
  </target>
  <target id="btn_openlog">
    <behaviour color="#333333" enabled="" offsetX="0" offsetY="0" radius="10" spread="0" type="behaviour\custom\DropShadowEffectBehaviour" when="ALWAYS"/>
  </target>
  <target id="btn_copyreport">
    <behaviour color="#333333" enabled="" offsetX="0" offsetY="0" radius="10" spread="0" type="behaviour\custom\DropShadowEffectBehaviour" when="ALWAYS"/>
  </target>
  <target id="btn_exit_game">
    <behaviour color="#333333" enabled="" offsetX="0" offsetY="0" radius="10" spread="0" type="behaviour\custom\DropShadowEffectBehaviour" when="ALWAYS"/>
  </target>
</behaviours>
